# =============================================================================
# Docker Ignore - SmartWard 4.0
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# IDE, editors, and AI agents
.idea
.vscode
.cursor
.agent
*.swp
*.swo

# Sub-projects not needed for main image
electron
gateway

# Node modules (we rebuild in Docker)
node_modules
ecg/node_modules
gateway/node_modules
HL7/node_modules

# Vendor (we rebuild in Docker)
vendor
bbraun/venv
mp5sc6_7/venv
ecg/venv
gateway/mindray_umec10/venv
bbraun/__pycache__
bbraun/logs

# Testing
tests
phpunit.xml
.phpunit.result.cache

# Development files
.env
.env.local
.env.*.local
docker/.env

# Docker env file - NOT ignored (needed for build)
!docker_swoole/docker.env

# Logs
storage/logs/*
!storage/logs/.gitkeep

# Cache
storage/framework/cache/*
!storage/framework/cache/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
bootstrap/cache/*
!bootstrap/cache/.gitkeep

# Database
database/*.sqlite
database/database.sqlite

# Documentation
*.md
!README.md

# OS files
.DS_Store
Thumbs.db

# Windows RoadRunner binary (we use Linux in Docker)
rr.exe
*.bat

# Build artifacts and symlinks
public/build
public/hot
public/storage

# Misc
stderr
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*




