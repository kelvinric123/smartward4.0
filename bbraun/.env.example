# =============================================================================
# B.Braun HL7 Infusion Pump Listener Configuration
# Copy this file to .env and adjust values as needed for local development
# For Docker deployment, settings are passed via docker-compose environment
# =============================================================================

# Listener Settings
BBRAUN_HOST=0.0.0.0
BBRAUN_PORT=5001

# Database Configuration (should match Laravel .env)
# For Docker: use 'smartward' as host (container name)
# For Local development: use 'localhost' or '127.0.0.1'
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartward
DB_USER=root
DB_PASSWORD=

# Development Mode Settings
# Set DEV_MODE=true to assign all infusion data to a specific MRN for testing
# Comment out or set to false in production
#DEV_MODE=true
#DEV_ASSIGN_MRN=10006

