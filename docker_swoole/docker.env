# =============================================================================
# Docker Environment Configuration - SmartWard 4.0
# This file is tracked in git and used by docker-compose
# =============================================================================

# Application Settings
APP_NAME=SmartWard
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database (internal MySQL in container)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartward
DB_USERNAME=root
DB_PASSWORD=smartward_secret

# Redis (internal Redis in container)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Session & Cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Broadcasting & Filesystem
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail (disabled for local)
MAIL_MAILER=log

# Octane/Swoole Settings (Aggressive for high-performance)
OCTANE_SERVER=swoole
OCTANE_WORKERS=16
OCTANE_TASK_WORKERS=16
OCTANE_MAX_REQUESTS=500

# Docker Port Mappings (external:internal)
APP_PORT=80
DB_PORT=3307
REDIS_PORT=6380

# Docker Resource Limits
DOCKER_CPU_LIMIT=8
DOCKER_MEMORY_LIMIT=8G
REDIS_MAXMEMORY=1gb

# ADT HL7 Listener Settings (for Docker inter-container communication)
ADT_HOST=adt
ADT_PORT=3000






