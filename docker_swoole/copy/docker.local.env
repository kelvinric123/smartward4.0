# =============================================================================
# Docker Environment Configuration - SmartWard 4.0, LOCAL PC
# Used by docker-compose.local.yml only; production uses docker.env.
# The app runs at http://localhost:8000
# =============================================================================

# Application Settings
# Not "production": that forces https:// links, which break on plain http://localhost:8000
APP_NAME=SmartWard
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Timezone (GMT+8 Kuala Lumpur)
TZ=Asia/Kuala_Lumpur
APP_TIMEZONE=Asia/Kuala_Lumpur

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database (internal MySQL in container)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartward
DB_USERNAME=root
DB_PASSWORD=smartward_secret

# Redis (internal Redis in container)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Session & Cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Broadcasting & Filesystem
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail (disabled for local)
MAIL_MAILER=log

# Octane/Swoole Settings (Aggressive for high-performance)
OCTANE_SERVER=swoole
OCTANE_WORKERS=16
OCTANE_TASK_WORKERS=16
OCTANE_MAX_REQUESTS=500

# Docker Port Mappings (external:internal) - for reference; the actual mappings
# are in docker-compose.local.yml: app 8000, nginx http 8080, nginx https 8443
APP_PORT=8000
DB_PORT=3307
REDIS_PORT=6380

# Docker Resource Limits
DOCKER_CPU_LIMIT=8
DOCKER_MEMORY_LIMIT=8G
REDIS_MAXMEMORY=1gb

# ADT HL7 Listener Settings (for Docker inter-container communication)
ADT_HOST=adt
ADT_PORT=3000

# =============================================================================
# MP5sc Vital Sign Monitor Listener Settings
# =============================================================================

# API Server Configuration (uses host network mode, so use 127.0.0.1)
MP5SC_API_BASE_URL=http://127.0.0.1:88/api/v1
MP5SC_API_PASSPHRASE=qmedno1
MP5SC_API_USERNAME=api@qmed.asia
MP5SC_API_PASSWORD=88888888

# Monitor Device Configuration (IP address of MP5sc monitor on local network)
MP5SC_MONITOR_IP=192.168.0.5

# Polling Configuration
MP5SC_POLL_INTERVAL=2
MP5SC_REFRESH_INTERVAL=10

# Debug Mode (set to true for verbose logging)
MP5SC_DEBUG_MODE=false

# =============================================================================
# B.Braun HL7 Infusion Pump Listener Settings
# =============================================================================

# Listener Port (external mapping)
BBRAUN_PORT=5001

# Development Mode (set to true to assign all data to specific MRN for testing)
BBRAUN_DEV_MODE=false
BBRAUN_DEV_ASSIGN_MRN=

# =============================================================================
# Seekink E-Ink Display Admin System Settings
# =============================================================================

# Server IP - REQUIRED: Replace with your public/external IP address
# This is critical for E-Ink device image updates to work correctly
SEEKINK_SERVER_IP=10.21.20.114

# Host Port - The external Java port (must match SEEKINK_JAVA_PORT)
SEEKINK_HOST_PORT=8088

# MQTT Enable - Set to 'true' ONLY if base station supports MQTT protocol
SEEKINK_MQTT_ENABLE=true

# Port Mappings
SEEKINK_JAVA_PORT=8088
SEEKINK_TCP_PORT=8003
SEEKINK_MQTT_PORT=1883

# Resource Limits
SEEKINK_CPU_LIMIT=2
SEEKINK_MEMORY_LIMIT=1G

# Default Login: http://localhost:8088
# Username: admin
# Password: admin123

# =============================================================================
# Testing / Connectivity
# =============================================================================
# Manually resolve the hostname for testing inside the container.
# Use 127.0.0.1 to test the local container itself, or a specific IP for remote testing.
PHKL_RESOLVE_IP=127.0.0.1
