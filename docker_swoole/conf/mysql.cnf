# =============================================================================
# MySQL/MariaDB Production Configuration
# Optimized for Laravel with Swoole persistent connections
# =============================================================================

[mysqld]
# Basic Settings
user = mysql
datadir = /var/lib/mysql
socket = /var/run/mysqld/mysqld.sock
port = 3306
bind-address = 0.0.0.0
skip-name-resolve = 1
skip-external-locking = 1

# Character Set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init-connect = 'SET NAMES utf8mb4'

# Connection Settings (aggressive for high-performance servers)
max_connections = 500
max_connect_errors = 1000
wait_timeout = 28800
interactive_timeout = 28800
connect_timeout = 10
net_read_timeout = 60
net_write_timeout = 120

# Buffer Pool and Memory (aggressive for high-memory servers)
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 8
innodb_log_file_size = 256M
innodb_log_buffer_size = 64M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_open_files = 2000
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000
innodb_read_io_threads = 8
innodb_write_io_threads = 8

# Query Cache (disabled in MySQL 8+, but kept for MariaDB)
query_cache_type = 0
query_cache_size = 0

# Temp Tables (aggressive)
tmp_table_size = 256M
max_heap_table_size = 256M
tmpdir = /tmp

# Thread Settings (aggressive)
thread_cache_size = 64
thread_stack = 512K

# Table Settings (aggressive)
table_open_cache = 2000
table_definition_cache = 2000
open_files_limit = 65535

# Binary Logging (optional - disable for single container)
skip-log-bin

# Slow Query Log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow-query.log
long_query_time = 2

# General Log (disabled in production)
general_log = 0

# Error Log
log_error = /var/log/mysql/error.log
log_warnings = 2

# Performance Schema (minimal in production)
performance_schema = OFF

# Security
local_infile = 0
symbolic-links = 0

[mysqld_safe]
socket = /var/run/mysqld/mysqld.sock
log-error = /var/log/mysql/error.log
pid-file = /var/run/mysqld/mysqld.pid
nice = 0

[client]
socket = /var/run/mysqld/mysqld.sock
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

