# Comen NC5 gateway - compose environment template.
# The compose file already defaults to these values, so this file is only
# needed to override something. To use it:
#   copy docker.env .env        (next to docker-compose.yml)
#   docker compose --env-file docker.env up -d

# Image (override for a specific tag)
NC5_IMAGE=kelvinric/nc5:latest

# Host port the NC5 connects to (container always listens on 2576)
NC5_LISTEN_PORT=2576

# SmartWard on the NAS. Use the internal name http://smartward:88/api/v1
# instead if you attach this container to smartward-network.
NC5_API_BASE_URL=http://192.168.0.88:18080/api/v1
NC5_API_PASSPHRASE=qmedno1
NC5_API_USERNAME=api@qmed.asia
NC5_API_PASSWORD=88888888

# Identity shown under Vital Sign Integration > Qmed Gateways
NC5_GATEWAY_ID=NC5-01
NC5_GATEWAY_NAME=NC5 Gateway

# Patient query (QRY^R02 / QRY^A19 answered from the SmartWard MRN lookup)
NC5_QUERY_ENABLED=true
# full | split_last | split_first - how SmartWard's single name field becomes
# HL7 PID-5 (Family^Given). "full" puts the whole name in the family component.
NC5_PATIENT_NAME_ORDER=full

# One charted reading per patient per this many seconds (a completed NIBP is
# charted immediately regardless).
NC5_RECORD_INTERVAL=300

# Timezone used for timestamps
TZ=Asia/Kuala_Lumpur

# Troubleshooting: SAVE_RAW writes every received HL7 message into the
# nc5_data volume under /data/raw
NC5_SAVE_RAW=false
NC5_DEBUG_MODE=false
