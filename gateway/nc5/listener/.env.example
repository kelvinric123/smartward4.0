API_BASE_URL=http://smartward:88/api/v1
API_PASSPHRASE=qmedno1
API_USERNAME=api@qmed.asia
API_PASSWORD=88888888
API_TIMEOUT=10

# Per-gateway identity (defaults to hostname if unset). Assigned by the server
# during provisioning; set a unique value per Pi if doing it by hand.
GATEWAY_ID=WARD3-NC5-01

# HL7/MLLP listener — the NC5 opens one long-lived connection to this port and
# uses it for both patient queries and observations. 2555 is the port the NC5
# ships configured for; change both sides together if you move it.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=2555
# App/facility names placed in MSH-3/MSH-4 of everything we send back.
ACK_APP=NC5_GATEWAY
ACK_FACILITY=SMARTWARD
# MSH-9 of the acknowledgement: "ACK" (accepted by the NC5) or "auto" for the
# HL7 2.4+ style ACK^<original trigger>.
ACK_MESSAGE_TYPE=ACK
# Seconds of idle before un-framed (non-MLLP) data is flushed to the handler.
IDLE_FLUSH_SECONDS=5
# A monitor counts as "connected" in the heartbeat for this long after its last
# message.
PEER_ONLINE_SECONDS=120

# Patient query (QRY^R02 / QRY^A19) answered from GET /api/v1/patients/{code}.
# Turn off only if another system answers the monitor's queries.
QUERY_ENABLED=true
# How long a resolved patient is reused without re-asking the API.
PATIENT_CACHE_TTL=60
# How long a previously confirmed patient may still be served when the API is
# unreachable. A "not found" answer is never cached or reused.
PATIENT_CACHE_STALE_TTL=86400
# PID-5 construction from SmartWard's single name field:
#   full        -> whole name in the family component (safe default)
#   split_last  -> last token is the family name (Western ordering)
#   split_first -> first token is the given name
PATIENT_NAME_ORDER=full

# Continuous-vitals aggregation. The NC5 streams observations every few seconds;
# one reading per patient is charted per window, carrying the latest value plus
# the PR/SpO2 range seen.
RECORD_INTERVAL=300
# Chart a completed NIBP immediately instead of waiting for the window.
FLUSH_ON_BP=true
# Close a window early when the monitor goes quiet (patient discharged, probe
# removed) so the tail of the data is not held in memory.
WINDOW_IDLE_TIMEOUT=60
# Drop a value whose own observation time is older than this relative to the
# newest one in the window — this is what stops a repeated old cuff reading
# from being charted again at the current time.
VITAL_STALENESS=300
# Two cuff cycles can legitimately read the same numbers. An identical BP is
# accepted as a new measurement only after this many seconds, which keeps a
# monitor that re-stamps its retransmissions from charting one BP repeatedly.
BP_REPEAT_GUARD=60

# Save every received HL7 message to RAW_DIR (troubleshooting only).
SAVE_RAW=false
RAW_DIR=./data/raw

# Optional: fetch the monitor-device registry from SmartWard to map monitor IPs
# to configured device names and push per-device status updates.
USE_API_DEVICES=false
DEVICE_FETCH_INTERVAL=60

# Sender / offline queue
SEND_INTERVAL=3
SEND_BATCH_SIZE=20
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
QUEUE_DB_PATH=./data/nc5.sqlite

# Queue retention (FIFO) and hard size cap
RETENTION_SENT_HOURS=72
RETENTION_DEAD_DAYS=14
MAX_DB_ROWS=100000
MAX_DB_MB=200

# Failure policy caps (when to stop retrying and dead-letter)
MAX_AGE_TRANSIENT_HOURS=168
MAX_AGE_404_MINUTES=120
MAX_ATTEMPTS_AUTH=3

# SpO2 / PR validation: values outside these bounds are treated as
# extreme/artifact and dropped from the payload.
SPO2_RANGE_MIN=50
SPO2_RANGE_MAX=100
PR_RANGE_MIN=30
PR_RANGE_MAX=220

# Heartbeat
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=30
# Extended stats (DB record range + network/Wi-Fi) sent less often, in seconds.
EXTENDED_INTERVAL=1800
# systemd unit name reported as the listener status in the heartbeat.
SERVICE_NAME=nc5

DEBUG_MODE=false
