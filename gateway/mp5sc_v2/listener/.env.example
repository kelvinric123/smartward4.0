API_BASE_URL=http://smartward:88/api/v1
API_PASSPHRASE=qmedno1
API_USERNAME=api@qmed.asia
API_PASSWORD=88888888

# Per-cart identity (defaults to hostname if unset). Set a unique value per Pi.
GATEWAY_ID=WARD3-CART-07

# Single-device fallback
MONITOR_IP=192.168.0.5

# true = fetch active devices from SmartWard API
USE_API_DEVICES=true
DEVICE_FETCH_INTERVAL=60

# Device polling
POLL_INTERVAL=2
REFRESH_INTERVAL=10

# Sender / offline queue
SEND_INTERVAL=3
SEND_BATCH_SIZE=20
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
QUEUE_DB_PATH=./data/mp5sc_v2.sqlite

# Queue retention (FIFO) and hard size cap
RETENTION_SENT_HOURS=72
RETENTION_DEAD_DAYS=14
MAX_DB_ROWS=100000
MAX_DB_MB=200

# Failure policy caps (when to stop retrying and dead-letter)
MAX_AGE_TRANSIENT_HOURS=168
MAX_AGE_404_MINUTES=120
MAX_ATTEMPTS_AUTH=3

# Patient safety
VITAL_STALENESS_SECONDS=60
IDENTITY_SETTLE_SECONDS=5

# SpO2 / PR range capture: values outside these bounds are treated as
# extreme/artifact and excluded from the reported min-max range.
SPO2_RANGE_MIN=50
SPO2_RANGE_MAX=100
PR_RANGE_MIN=30
PR_RANGE_MAX=220

# Temperature capture. The monitor publishes temperature under more than one
# label: the value taken/confirmed on the monitor and the value from the temp
# probe. The monitor value is used first; the probe value is used whenever the
# monitor value is missing, so a probe-only reading is no longer dropped.
# TEMP_PRIMARY_IDS = labels treated as "taken on the monitor".
# Any other label inside the temperature band below is treated as the probe.
# Set DEBUG_MODE=true once on a cart to log which labels the monitor actually
# uses, then pin the probe label here if it falls outside the band.
TEMP_PRIMARY_IDS=19272,19296,19298,61639
TEMP_SECONDARY_IDS=
TEMP_ID_BAND_MIN=19272
TEMP_ID_BAND_MAX=19420
# Plausible range in Celsius; readings outside it are ignored.
TEMP_MIN_C=25
TEMP_MAX_C=45
# Convert a Fahrenheit-reporting channel to Celsius, and rescale channels that
# publish unscaled integers (365 -> 36.5).
TEMP_FAHRENHEIT_AUTOCONVERT=true
TEMP_AUTOSCALE=true
# How far the two sources may differ and still count as the same reading.
TEMP_AGREEMENT_TOLERANCE=0.3

# Heartbeat (Phase 3)
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=30
# Extended stats (DB record range + network/Wi-Fi) sent less often, in seconds.
EXTENDED_INTERVAL=1800
# systemd unit name reported as the listener status in the heartbeat.
SERVICE_NAME=mp5sc
# Uplink interface for the network self-healing watchdog (netwatch.sh).
UPLINK_IF=wlan0
# Let the watchdog reboot the Pi as a last resort after a long link outage.
NETWATCH_ALLOW_REBOOT=true

DEBUG_MODE=false
