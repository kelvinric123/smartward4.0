API_BASE_URL=http://smartward:88/api/v1
API_PASSPHRASE=qmedno1
API_USERNAME=api@qmed.asia
API_PASSWORD=88888888

# Per-cart identity (defaults to hostname if unset). Set a unique value per Pi.
GATEWAY_ID=WARD3-CART-07

# Single-device fallback
MONITOR_IP=192.168.0.5

# true = fetch active devices from SmartWard API
USE_API_DEVICES=true
DEVICE_FETCH_INTERVAL=60

# Device polling
POLL_INTERVAL=2
REFRESH_INTERVAL=10

# Sender / offline queue
SEND_INTERVAL=3
SEND_BATCH_SIZE=20
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
QUEUE_DB_PATH=./data/mp5sc_v2.sqlite

# Queue retention (FIFO) and hard size cap
RETENTION_SENT_HOURS=72
RETENTION_DEAD_DAYS=14
MAX_DB_ROWS=100000
MAX_DB_MB=200

# Failure policy caps (when to stop retrying and dead-letter)
MAX_AGE_TRANSIENT_HOURS=168
MAX_AGE_404_MINUTES=120
MAX_ATTEMPTS_AUTH=3

# Patient safety
VITAL_STALENESS_SECONDS=60
IDENTITY_SETTLE_SECONDS=5

# SpO2 / PR range capture: values outside these bounds are treated as
# extreme/artifact and excluded from the reported min-max range.
SPO2_RANGE_MIN=50
SPO2_RANGE_MAX=100
PR_RANGE_MIN=30
PR_RANGE_MAX=220

# Temperature / respiratory rate physio ids. Both metrics reach the monitor
# either from a probe or as a value keyed in on the monitor, and each source
# uses its own id, so every candidate is polled and the most recently changed
# one wins. Add ids here (decimal or 0x..) after confirming them with
# PHYSIO_DISCOVERY - no code change needed. Ids above 65535 are ignored.
TEMP_PHYSIO_IDS=19272,19296,19298,19328,19330,19360,19394,61639
RR_PHYSIO_IDS=20480,20482,20490,20498,20514,53250,63528
# Which of the ids above are keyed-in-on-the-monitor values rather than device
# measurements. Only used by PHYSIO_SOURCE_PREFERENCE and for log labelling.
TEMP_MANUAL_PHYSIO_IDS=
RR_MANUAL_PHYSIO_IDS=
# Who wins while a probe and a keyed-in value are both on screen:
#   latest (default) = most recently changed value
#   manual           = keyed-in value always wins while it is displayed
#   probe            = device measurement always wins
PHYSIO_SOURCE_PREFERENCE=latest
# A value cleared/deleted on the monitor stops appearing in the poll; drop it
# after this many poll cycles (grace for demographics polls and lost packets).
PHYSIO_MISSING_CYCLES=3
# Upper bound: how long a spot value may keep riding along at all.
TEMP_TTL_SECONDS=600
RR_TTL_SECONDS=600
# Measurement-state bits that make a sample unusable (0x8000 = invalid).
PHYSIO_STATE_REJECT_MASK=0x8000
# Log every numeric observation (id, value, state, unit, handle) as it changes,
# to identify which ids your monitor uses for probe vs keyed-in values.
PHYSIO_DISCOVERY=false
# Seconds between census dumps listing every numeric the monitor sends, which
# ones are selected as Temp/RR, and any data lost to truncated/incomplete polls.
# 0 = off. Set to e.g. 300 while commissioning a new monitor.
PHYSIO_REPORT_INTERVAL=0

# Heartbeat (Phase 3)
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=30
# Extended stats (DB record range + network/Wi-Fi) sent less often, in seconds.
EXTENDED_INTERVAL=1800
# systemd unit name reported as the listener status in the heartbeat.
SERVICE_NAME=mp5sc
# Uplink interface for the network self-healing watchdog (netwatch.sh).
UPLINK_IF=wlan0
# Let the watchdog reboot the Pi as a last resort after a long link outage.
NETWATCH_ALLOW_REBOOT=true

DEBUG_MODE=false
