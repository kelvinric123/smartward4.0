API_BASE_URL=http://smartward:88/api/v1
API_PASSPHRASE=qmedno1
API_USERNAME=api@qmed.asia
API_PASSWORD=88888888

# Per-cart identity (defaults to hostname if unset). Set a unique value per Pi.
GATEWAY_ID=WARD3-CART-07

# Single-device fallback
MONITOR_IP=192.168.0.5

# true = fetch active devices from SmartWard API
USE_API_DEVICES=true
DEVICE_FETCH_INTERVAL=60

# Device polling
POLL_INTERVAL=2
REFRESH_INTERVAL=10

# Sender / offline queue
SEND_INTERVAL=3
SEND_BATCH_SIZE=20
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
QUEUE_DB_PATH=./data/mp5sc_v2.sqlite

# Queue retention (FIFO) and hard size cap
RETENTION_SENT_HOURS=72
RETENTION_DEAD_DAYS=14
MAX_DB_ROWS=100000
MAX_DB_MB=200

# Failure policy caps (when to stop retrying and dead-letter)
MAX_AGE_TRANSIENT_HOURS=168
MAX_AGE_404_MINUTES=120
MAX_ATTEMPTS_AUTH=3

# Patient safety
VITAL_STALENESS_SECONDS=60
IDENTITY_SETTLE_SECONDS=5

# SpO2 / PR range capture: values outside these bounds are treated as
# extreme/artifact and excluded from the reported min-max range.
SPO2_RANGE_MIN=50
SPO2_RANGE_MAX=100
PR_RANGE_MIN=30
PR_RANGE_MAX=220

# Heartbeat (Phase 3)
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=30
# Extended stats (DB record range + network/Wi-Fi) sent less often, in seconds.
EXTENDED_INTERVAL=1800

DEBUG_MODE=false
