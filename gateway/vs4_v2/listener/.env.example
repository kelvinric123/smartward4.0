API_BASE_URL=http://smartward:88/api/v1
API_PASSPHRASE=qmedno1
API_USERNAME=api@qmed.asia
API_PASSWORD=88888888

# Per-gateway identity (defaults to hostname if unset). Assigned by the server
# during deploy_pi/setup.sh; set a unique value per Pi if provisioning by hand.
GATEWAY_ID=WARD3-VS4-01

# HL7/MLLP listener — the VS4 pushes ORU^R01 messages TO this gateway.
# Point the VS4's HL7 export at this machine's IP and this port.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=4000
# App/facility names used in the ACK we send back to the VS4.
ACK_APP=VS4_GATEWAY
ACK_FACILITY=SMARTWARD
# Seconds of idle before un-framed (non-MLLP) data is flushed to the handler.
IDLE_FLUSH_SECONDS=5
# A sender counts as "connected" in the heartbeat for this long after its last
# message (spot-check monitors only connect when a reading is taken).
PEER_ONLINE_SECONDS=300

# Save every received HL7 message to RAW_DIR (troubleshooting only).
SAVE_RAW=false
RAW_DIR=./data/raw

# Optional: fetch the monitor-device registry from SmartWard to map sender IPs
# to configured device names and push per-device status updates.
USE_API_DEVICES=false
DEVICE_FETCH_INTERVAL=60

# Sender / offline queue
SEND_INTERVAL=3
SEND_BATCH_SIZE=20
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
QUEUE_DB_PATH=./data/vs4_v2.sqlite

# Queue retention (FIFO) and hard size cap
RETENTION_SENT_HOURS=72
RETENTION_DEAD_DAYS=14
MAX_DB_ROWS=100000
MAX_DB_MB=200

# Failure policy caps (when to stop retrying and dead-letter)
MAX_AGE_TRANSIENT_HOURS=168
MAX_AGE_404_MINUTES=120
MAX_ATTEMPTS_AUTH=3

# SpO2 / PR validation: values outside these bounds are treated as
# extreme/artifact and dropped from the payload.
SPO2_RANGE_MIN=50
SPO2_RANGE_MAX=100
PR_RANGE_MIN=30
PR_RANGE_MAX=220

# Heartbeat
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=30
# Extended stats (DB record range + network/Wi-Fi) sent less often, in seconds.
EXTENDED_INTERVAL=1800
# systemd unit name reported as the listener status in the heartbeat.
SERVICE_NAME=vs4
# Uplink interface for the network self-healing watchdog (netwatch.sh).
UPLINK_IF=wlan0
# Let the watchdog reboot the Pi as a last resort after a long link outage.
NETWATCH_ALLOW_REBOOT=true

DEBUG_MODE=false
