# Local development / testing config. On the Pi, setup.sh writes the real
# config to /var/lib/ecg-usb/ecg-usb.env and this file is not used.
API_BASE_URL=http://smartward:88/api/v1
API_PASSPHRASE=qmedno1
API_USERNAME=api@qmed.asia
API_PASSWORD=88888888

# Per-gateway identity (defaults to hostname if unset). Assigned by the server
# during deploy_pi/setup.sh (registered with gateway_type=ecg).
GATEWAY_ID=WARD3-ECG-USB-01

# Where the TC35's files come from:
#   image = the FAT32 image behind the USB mass-storage gadget (the Pi)
#   dir   = a plain folder, for testing on a laptop: drop TC35 XML files
#           into WATCH_DIR (python make_sample_ecg.py listener/data/usb)
SOURCE_MODE=dir
WATCH_DIR=./data/usb
USB_IMAGE_PATH=/var/lib/ecg-usb/usb_drive.img
USB_MOUNT_DIR=/var/lib/ecg-usb/mnt
GADGET_NAME=smartward_ecg

# Watcher: scan once the drive has had no writes for QUIET_SECONDS; a file
# still incomplete after INCOMPLETE_GIVEUP_SECONDS is captured as-is; a PDF
# waits PDF_PAIR_GRACE_SECONDS for its XML.
POLL_SECONDS=2
QUIET_SECONDS=8
FULL_SCAN_SECONDS=900
INCOMPLETE_GIVEUP_SECONDS=600
PDF_PAIR_GRACE_SECONDS=120

# Drive cleanup (delivered recordings only, when the drive is idle and full).
CLEANUP_ENABLED=true
CLEANUP_AT_PCT=80
CLEANUP_QUIET_SECONDS=900

# Captured ECG files (XML + extracted PDF), kept until sent + retention.
FILES_DIR=./data/files
MAX_FILES_MB=2000

# Sender / offline queue
SEND_INTERVAL=3
SEND_BATCH_SIZE=5
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
QUEUE_DB_PATH=./data/ecg_usb_gateway.sqlite

RETENTION_SENT_HOURS=168
RETENTION_DEAD_DAYS=30
MAX_DB_ROWS=50000
MAX_DB_MB=50
MAX_AGE_TRANSIENT_HOURS=336
MAX_ATTEMPTS_AUTH=3

HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=30
EXTENDED_INTERVAL=1800
SERVICE_NAME=ecg-usb-gateway

DEBUG_MODE=false
