[Unit]
Description=ECG USB gateway network self-healing watchdog
After=network.target

[Service]
Type=simple
# Root: needs nmcli device control, NetworkManager restart, and reboot.
ExecStart=/opt/ecg-usb/netwatch.sh /var/lib/ecg-usb/ecg-usb.env
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecg-usb-netwatch

[Install]
WantedBy=multi-user.target
