[Unit]
Description=CM100 gateway network self-healing watchdog
After=network.target

[Service]
Type=simple
# Root: needs nmcli device control, NetworkManager restart, and reboot.
ExecStart=/opt/cm100/netwatch.sh /var/lib/cm100/cm100.env
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cm100-netwatch

[Install]
WantedBy=multi-user.target
