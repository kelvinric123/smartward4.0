API_BASE_URL=http://smartward:88/api/v1
API_PASSPHRASE=qmedno1
API_USERNAME=api@qmed.asia
API_PASSWORD=88888888

# Per-gateway identity (defaults to hostname if unset). Assigned by the server
# during deploy_pi/setup.sh (registered with gateway_type=ecg, so it appears
# as an ECG gateway on the vital-sign-integration dashboard).
GATEWAY_ID=WARD3-ECG-01

# ECG HTTP listener — the Philips TC35 POSTs XML/PDF to this gateway with
# Basic auth, exactly like the dockerized ecg listener it mirrors.
# Configure the TC35: URL http://<this-Pi's-static-IP>:3050/  method POST.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=3050
ECG_USERNAME=admin
ECG_PASSWORD=admin123
# Uploads larger than this are rejected (protects RAM/disk from junk).
MAX_UPLOAD_MB=25
# An ECG machine counts as "connected" in the heartbeat for this long after
# its last upload (ECGs are occasional, so keep this generous).
PEER_ONLINE_SECONDS=3600

# Where received ECG files (XML + extracted PDF) are kept. Files remain until
# their outbox row is sent + past retention, then the janitor sweeps them.
FILES_DIR=./data/files
# Hard cap for the file store; oldest SENT files are removed first.
MAX_FILES_MB=2000

# Sender / offline queue
SEND_INTERVAL=3
SEND_BATCH_SIZE=5
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
QUEUE_DB_PATH=./data/ecg_gateway.sqlite

# Queue retention (FIFO) and hard size cap. ECGs are rarer and bigger than
# vitals, so sent rows are kept a full week for audit.
RETENTION_SENT_HOURS=168
RETENTION_DEAD_DAYS=30
MAX_DB_ROWS=50000
MAX_DB_MB=50

# Failure policy caps (when to stop retrying and dead-letter)
MAX_AGE_TRANSIENT_HOURS=336
MAX_ATTEMPTS_AUTH=3

# Heartbeat (carries gateway_type=ecg + the ecg counters block)
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=30
EXTENDED_INTERVAL=1800
SERVICE_NAME=ecg-gateway
# Uplink interface for the network self-healing watchdog (netwatch.sh).
UPLINK_IF=wlan0
NETWATCH_ALLOW_REBOOT=true

DEBUG_MODE=false
