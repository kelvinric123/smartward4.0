# =============================================================================
# Vital Sign Listener Configuration
# Copy this file to .env and update the values
# For Docker: These are configured via docker.env instead
# =============================================================================

# ===========================================
# API Server Configuration (API V1)
# ===========================================

# Base URL of the API server (without trailing slash)
# For local/standalone: http://YOUR_SERVER_IP/api/v1
# For Docker (host network mode): http://127.0.0.1:88/api/v1
API_BASE_URL=http://10.21.20.114/api/v1

# API Passphrase for X-Passphrase header (required for every request)
API_PASSPHRASE=qmedno1

# ===========================================
# API User Credentials (included in request body)
# ===========================================

# Username for API authentication (create an API user in SmartWard)
API_USERNAME=api@qmed.asia

# Password for API authentication
API_PASSWORD=88888888

# ===========================================
# Monitor Device Configuration
# ===========================================

# IP address of the Philips MP5sc medical monitor device
# The listener connects to this device via UDP port 24105
MONITOR_IP=192.168.0.5

# ===========================================
# Polling Configuration
# ===========================================

# Polling interval in seconds (how often to check for new data)
# Lower = more frequent updates but more network traffic
POLL_INTERVAL=2

# Patient data refresh interval (number of iterations before refreshing patient data)
# Every REFRESH_INTERVAL polls, patient demographics are re-requested
REFRESH_INTERVAL=10

# ===========================================
# Debug Configuration
# ===========================================

# Enable debug mode for verbose logging (true/false)
# Shows raw values from device and unknown physio IDs
DEBUG_MODE=false
