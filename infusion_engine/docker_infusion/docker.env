# Infusion Engine stack - compose environment template
# Copy to .env next to docker-compose.yml (or: docker compose --env-file docker.env up -d)

# Image (override for a specific tag)
INFUSION_IMAGE=kelvinric/infusion:latest

# Host ports
INFUSION_MLLP_PORT=6000
INFUSION_API_PORT=6001

# PostgreSQL credentials (internal to the stack)
INFUSION_DB_NAME=infusion
INFUSION_DB_USER=infusion
INFUSION_DB_PASSWORD=infusion_secret

# Timezone
TZ=Asia/Kuala_Lumpur

# API key SmartWard must send in the X-API-Key header. Empty = no auth.
INFUSION_API_KEY=

# Purge stored messages older than N days (0 = keep forever)
INFUSION_RETENTION_DAYS=0

# Demo pump simulator endpoints + management page demo tab (false in production)
INFUSION_DEMO_ENABLED=true

# SmartWard base URL - demo tab lists SmartWard's registered pumps so demo
# Device IDs match the pumps SmartWard binds to patients (empty = disabled)
INFUSION_SMARTWARD_URL=http://192.168.0.88:18080

LOG_LEVEL=INFO
