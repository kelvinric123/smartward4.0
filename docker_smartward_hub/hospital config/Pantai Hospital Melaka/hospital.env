# =============================================================================
# SmartWard 4.0 - settings for Pantai Hospital Melaka
# "build hospital config.bat" builds docker-compose.yml in this folder from these.
# To change one: edit it here, run the .bat again (press Enter at each question),
# then copy the new docker-compose.yml to the hospital's server.
# The database settings are not here on purpose: the database inside the image
# is created with the template's values, so they must stay as they are.
# =============================================================================

# --- Hospital
# Shown in the generated files
HOSPITAL_NAME='Pantai Hospital Melaka'
# Docker project name. On a server that already runs SmartWard from a docker_smartward_hub folder, keep docker_smartward_hub so it keeps its database
PROJECT_NAME=docker_smartward_hub

# --- Address users open in the browser
APP_URL=http://192.168.0.22:18080
# Normally the same as APP_URL
ASSET_URL=http://192.168.0.22:18080
# Set from APP_URL: production for https:// (all links are forced to https://), local for plain http://
APP_ENV=local
# true shows error details on screen; keep false on a hospital server
APP_DEBUG=false
APP_NAME=SmartWard
# What the hospital domain points to inside the app container; 127.0.0.1 is the container itself
PHKL_RESOLVE_IP=127.0.0.1

# --- Image
# Use a fixed tag instead of latest to pin this hospital to a version
SMARTWARD_IMAGE=kelvinric/smartward4:latest

# --- Ports on the hospital server
# Nginx http
HTTP_PORT=18080
# Nginx https
HTTPS_PORT=18443
# The app directly (Octane)
APP_PORT=8888
# MySQL
DB_PORT=3307
# Redis
REDIS_PORT=6380
# ADT HL7 listener
HL7_PORT=3000
# ECG upload server
ECG_PORT=3051
# B.Braun infusion listener
BBRAUN_PORT=5001

# --- Time zone
TZ=Asia/Kuala_Lumpur
APP_TIMEZONE=Asia/Kuala_Lumpur

# --- Performance
OCTANE_WORKERS=16
OCTANE_TASK_WORKERS=16
OCTANE_MAX_REQUESTS=500
# CPUs the app container may use
DOCKER_CPU_LIMIT=2
# Memory the app container may use
DOCKER_MEMORY_LIMIT=4G
LOG_LEVEL=warning

# --- Integrations
# ECG upload server login
ECG_USERNAME=admin
ECG_PASSWORD=admin123
# Key the ADT listener sends to the app
LARAVEL_API_KEY=
BBRAUN_DEV_MODE=false
BBRAUN_DEV_ASSIGN_MRN=
