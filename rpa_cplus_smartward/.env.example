# Copy to .env and fill in. .env is gitignored.

# --- C+ / HIS (Cerebral), production ---
HIS_BASE_URL=https://cerebral.ihhmy.com
HIS_USERNAME=rpa.qmed
HIS_PASSWORD=
# Login facility, picked by id. rpa.qmed has PHAK = 26 (listed first) and
# PHKL = 33. HIS_FACILITY is a cross-check against the dropdown's name.
HIS_FACILITY=PHAK
HIS_FACILITY_ID=26
# A failed login is never retried: it blocks all logins until cleared with
# login.py --clear-login-block. Logins are also never closer than this.
HIS_MIN_LOGIN_INTERVAL_MINUTES=15
# Where the session cookies live (default cookies_smartward.txt in this folder).
# Never point this at another RPA's jar.
HIS_COOKIE_JAR=

# --- SmartWard (where Bed Management is pushed) ---
# e.g. http://10.14.16.100:18080 at the hospital, http://127.0.0.1:8000 locally
SMARTWARD_URL=
# API token of a SmartWard Integration User (Users > Edit > Generate token)
SMARTWARD_TOKEN=

# --- Sync ---
# Bed Management unit groups read with "All Locations": 2 = Ward (IP), 6 = Day Care Unit
SYNC_UNIT_GROUPS=2
SYNC_INTERVAL_MINUTES=5
# Also read ER Management (the ED's zones, tagged Emergency in SmartWard for Command Center V2 (ED))
SYNC_ER=true
# Admission dates: census Entry Date of these unit groups, else a reservation
# request's Request Date with a plan date in the last REQUEST_LOOKBACK_DAYS days
CENSUS_UNIT_GROUPS=2,6
REQUEST_LOOKBACK_DAYS=7
