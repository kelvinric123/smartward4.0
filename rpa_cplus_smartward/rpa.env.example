# Settings for the rpa_cplus_smartward container (docker-compose.yml).
# Copy to rpa.env next to docker-compose.yml and fill in. Keep rpa.env private:
# it holds the C+ password.

# --- C+ / HIS (Cerebral), production ---
HIS_BASE_URL=https://cerebral.ihhmy.com
HIS_USERNAME=rpa.qmed
HIS_PASSWORD=
# Login facility, picked by id: PHAK = 26, PHKL = 33
HIS_FACILITY=PHAK
HIS_FACILITY_ID=26
HIS_MIN_LOGIN_INTERVAL_MINUTES=15

# --- SmartWard ---
SMARTWARD_URL=http://10.14.16.100:18080
# API token of a SmartWard Integration User (Users > Edit > Generate token)
SMARTWARD_TOKEN=

# --- Sync ---
SYNC_UNIT_GROUPS=2
SYNC_INTERVAL_MINUTES=5
# Also read ER Management (the ED's zones, tagged Emergency in SmartWard for Command Center V2 (ED))
SYNC_ER=true
CENSUS_UNIT_GROUPS=2,6
REQUEST_LOOKBACK_DAYS=7
# Isolation box of each ward patient's C+ admission card (C+ is SmartWard's main source of isolation):
# one C+ page per patient, read again after ISOLATION_REFRESH_MINUTES, at most ISOLATION_MAX_READS per sync
SYNC_ISOLATION=true
ISOLATION_REFRESH_MINUTES=30
ISOLATION_MAX_READS=60
