# =============================================================================
# Seekink E-Ink Display Admin System - Environment Configuration
# This file is tracked in git and used by docker-compose
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Server IP - REQUIRED: Replace with your public/external IP address
# This is critical for image updates to work correctly on E-Ink devices
# Example: 192.168.1.100 or your public IP
SEEKINK_SERVER_IP=192.168.0.1

# Host Port - The external Java port that devices will connect to
# Must match the external port mapping in docker-compose.yml
# Default: 8088 (since 8080 is typically used by other services)
SEEKINK_HOST_PORT=8088

# -----------------------------------------------------------------------------
# MQTT Configuration
# -----------------------------------------------------------------------------

# MQTT Enable - Set to 'true' ONLY if your base station supports MQTT protocol
# Leave as 'false' if unsure or if using standard connection mode
SEEKINK_MQTT_ENABLE=false

# -----------------------------------------------------------------------------
# Port Mappings (External Ports)
# -----------------------------------------------------------------------------

# Java Port - Web Admin Interface (external:8080 internal)
# Access the login backend at: http://<server-ip>:<SEEKINK_JAVA_PORT>
SEEKINK_JAVA_PORT=8088

# TCP Port - Device Communication Protocol
SEEKINK_TCP_PORT=8003

# MQTT Port - Message Queue for base stations (if MQTT_ENABLE=true)
SEEKINK_MQTT_PORT=1883

# -----------------------------------------------------------------------------
# Resource Limits
# -----------------------------------------------------------------------------

# CPU limit for the container
SEEKINK_CPU_LIMIT=2

# Memory limit for the container
SEEKINK_MEMORY_LIMIT=1G

# -----------------------------------------------------------------------------
# Default Login Credentials (Change after first login!)
# -----------------------------------------------------------------------------
# Username: admin
# Password: admin123
# 
# Access URL: http://localhost:8088 (or http://<SERVER_IP>:8088)
# -----------------------------------------------------------------------------
